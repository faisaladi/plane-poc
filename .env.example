# ==============================================================================
# PLANE SELF-HOSTED ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN SETTINGS
# ------------------------------------------------------------------------------
WEB_URL=http://localhost
SECRET_KEY=change_this_to_a_secure_random_64_character_string
LIVE_SERVER_SECRET_KEY=change_this_to_a_secure_random_64_character_string
API_BASE_URL=http://plane-backend:8000
PLANE_ENVIRONMENT=production
ANALYTICS_OPT_OUT=1
GUNICORN_WORKERS=1

# Proxy & upload routing settings
SITE_ADDRESS=:80
BUCKET_NAME=plane-uploads
FILE_SIZE_LIMIT=26214400

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=plane-db
POSTGRES_PORT=5432
POSTGRES_DB=plane
POSTGRES_USER=plane_user
POSTGRES_PASSWORD=change_this_postgres_password

# ------------------------------------------------------------------------------
# 3. CACHE & SESSION STORE (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:change_this_redis_password@plane-redis:6379/0

# ------------------------------------------------------------------------------
# 4. MESSAGE BROKER (RabbitMQ)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane_mq
RABBITMQ_PASSWORD=change_this_rabbitmq_password
RABBITMQ_DEFAULT_USER=plane_mq
RABBITMQ_DEFAULT_PASS=change_this_rabbitmq_password

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (MinIO / S3)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=minio_access_key_admin
AWS_SECRET_ACCESS_KEY=minio_secret_key_change_me
AWS_S3_BUCKET_NAME=plane-uploads
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_REGION_NAME=us-east-1
USE_MINIO=1

# ------------------------------------------------------------------------------
# 6. EMAIL CONFIGURATION (SMTP for Magic Link & Notifications)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_FROM_EMAIL=noreply@yourcompany.com
USE_TLS=True
USE_SSL=False

# ------------------------------------------------------------------------------
# 7. THIRD-PARTY OAUTH AUTHENTICATION (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
